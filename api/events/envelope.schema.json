{
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "listing.changed",
        "message.created"
      ]
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "format": "int64",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "aggregate_id",
    "aggregate_version",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace.example/schemas/envelope.schema.json"
}
